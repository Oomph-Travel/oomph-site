{
  "name": "oomph-site-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end smoke tests for oomphtravel.com (Playwright). Not part of the deployed theme — repo-root tooling only.",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "audit:lh": "node scripts/audit/lighthouse-audit.mjs",
    "audit:links": "node scripts/audit/link-audit.mjs",
    "audit:a11y": "playwright test -c playwright.audit.config.ts",
    "images": "node scripts/images/optimize.mjs",
    "fonts": "bash scripts/fonts/subset.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.49.0",
    "lighthouse": "^12.8.2",
    "sharp": "^0.35.3"
  }
}
