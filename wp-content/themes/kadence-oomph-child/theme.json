{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "duotone": [],
      "palette": [
        { "slug": "peacock-ink",     "name": "Peacock Ink",     "color": "#1F4E5F" },
        { "slug": "terracotta-warm", "name": "Terracotta Warm", "color": "#B8543A" },
        { "slug": "true-ink",        "name": "True Ink",        "color": "#14171A" },
        { "slug": "paper",           "name": "Paper",           "color": "#FEFCF8" },
        { "slug": "bone",            "name": "Bone",            "color": "#FBF6EC" },
        { "slug": "mist",            "name": "Mist",            "color": "#F1EADC" },
        { "slug": "stone",           "name": "Stone",           "color": "#C5BBA8" },
        { "slug": "slate",           "name": "Slate",           "color": "#7C786C" },
        { "slug": "charcoal",        "name": "Charcoal",        "color": "#2C2A26" },
        { "slug": "deep-peacock",    "name": "Deep Peacock",    "color": "#0F3640" },
        { "slug": "muted-brick",     "name": "Muted Brick",     "color": "#8C3A2E" },
        { "slug": "warm-ochre",      "name": "Warm Ochre",      "color": "#C2873E" },
        { "slug": "soft-sage",       "name": "Soft Sage",       "color": "#8A9A85" },
        { "slug": "champagne",       "name": "Champagne",       "color": "#D9C5A6" },
        { "slug": "dusty-rose",      "name": "Dusty Rose",      "color": "#C9A09A" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "fraunces",
          "name": "Fraunces",
          "fontFamily": "Fraunces, 'Iowan Old Style', Georgia, 'Times New Roman', serif"
        },
        {
          "slug": "inter",
          "name": "Inter",
          "fontFamily": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "eyebrow", "name": "Eyebrow", "size": "var(--text-eyebrow)" },
        { "slug": "body-sm", "name": "Body Small", "size": "var(--text-body-sm)" },
        { "slug": "body",    "name": "Body",    "size": "var(--text-body)" },
        { "slug": "lead",    "name": "Lead",    "size": "var(--text-lead)" },
        { "slug": "h3",      "name": "H3",      "size": "var(--text-h3)" },
        { "slug": "h2",      "name": "H2",      "size": "var(--text-h2)" },
        { "slug": "h1",      "name": "H1",      "size": "var(--text-h1)" },
        { "slug": "display", "name": "Display", "size": "var(--text-display)" }
      ],
      "lineHeight": true,
      "letterSpacing": true,
      "textTransform": true,
      "fontStyle": true,
      "fontWeight": true
    },
    "spacing": {
      "customSpacingSize": false,
      "spacingScale": { "steps": 0 },
      "spacingSizes": [
        { "slug": "1",  "name": "1 — 4px",   "size": "4px" },
        { "slug": "2",  "name": "2 — 8px",   "size": "8px" },
        { "slug": "3",  "name": "3 — 12px",  "size": "12px" },
        { "slug": "4",  "name": "4 — 16px",  "size": "16px" },
        { "slug": "5",  "name": "5 — 24px",  "size": "24px" },
        { "slug": "6",  "name": "6 — 32px",  "size": "32px" },
        { "slug": "7",  "name": "7 — 40px",  "size": "40px" },
        { "slug": "8",  "name": "8 — 56px",  "size": "56px" },
        { "slug": "9",  "name": "9 — 72px",  "size": "72px" },
        { "slug": "10", "name": "10 — 96px", "size": "96px" },
        { "slug": "11", "name": "11 — 128px","size": "128px" }
      ],
      "units": ["px", "rem", "em", "%", "vh", "vw"]
    },
    "layout": {
      "contentSize": "740px",
      "wideSize": "1280px"
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--bone)",
      "text": "var(--wp--preset--color--true-ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--body)",
      "lineHeight": "1.55"
    },
    "spacing": {
      "padding": {
        "top": "0",
        "right": "var(--wp--preset--spacing--7)",
        "bottom": "0",
        "left": "var(--wp--preset--spacing--7)"
      },
      "blockGap": "var(--wp--preset--spacing--6)"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fraunces)",
          "fontSize": "var(--wp--preset--font-size--h1)",
          "fontWeight": "300",
          "lineHeight": "1.1"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fraunces)",
          "fontSize": "var(--wp--preset--font-size--h2)",
          "fontWeight": "400",
          "lineHeight": "1.22"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fraunces)",
          "fontSize": "var(--wp--preset--font-size--h3)",
          "fontWeight": "400",
          "lineHeight": "1.3"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontWeight": "500",
          "textTransform": "uppercase",
          "letterSpacing": "0.08em",
          "fontSize": "var(--wp--preset--font-size--eyebrow)"
        }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--peacock-ink)" },
        "typography": { "textDecoration": "underline" },
        ":hover": { "color": { "text": "var(--wp--preset--color--terracotta-warm)" } }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--terracotta-warm)",
          "text": "var(--wp--preset--color--paper)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontSize": "var(--wp--preset--font-size--body)",
          "fontWeight": "500",
          "letterSpacing": "0.01em",
          "textTransform": "none"
        },
        "border": { "radius": "4px" },
        "spacing": {
          "padding": {
            "top": "12px",
            "right": "24px",
            "bottom": "12px",
            "left": "24px"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--muted-brick)",
            "text": "var(--wp--preset--color--paper)"
          }
        }
      },
      "caption": {
        "color": { "text": "var(--wp--preset--color--slate)" },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--body-sm)",
          "fontStyle": "italic"
        }
      }
    }
  }
}
